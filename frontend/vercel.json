{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://postal-zoloft-characterized-species.trycloudflare.com/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://postal-zoloft-characterized-species.trycloudflare.com/sanctum/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
