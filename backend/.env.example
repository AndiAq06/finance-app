APP_NAME=Finora
APP_ENV=local
# Jalankan `php artisan key:generate` untuk mengisi APP_KEY. Jangan commit nilai asli.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# URL SPA (dipakai untuk CORS & Sanctum stateful domain)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL. Untuk docker compose gunakan DB_HOST=mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finora
DB_USERNAME=finora
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): set true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Domain SPA yang boleh memakai cookie session Sanctum (host:port, pisahkan dengan koma)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@finora.local"
MAIL_FROM_NAME="${APP_NAME}"

# Data demo hanya untuk development. Seeder demo menolak berjalan saat APP_ENV=production.
DEMO_ENABLED=true
